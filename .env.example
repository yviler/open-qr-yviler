# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/qr_db

# Flask secret key — change this to a long random string in production
FLASK_SECRET_KEY=change-me-in-production

# Set to 1 to enable Flask debug mode
FLASK_DEBUG=0

# Default language shown to customers (en or id)
QR_LANG=en

# Default guest name used when customer doesn't provide one
QR_GUEST_NAME=Guest

# How long (in seconds) a QR scan grants table access (default: 5 hours)
QR_ACCESS_TTL_SECONDS=18000

# Cart polling interval in milliseconds
CART_POLL_INTERVAL_MS=8000

# Port to bind to
PORT=5001

# Optional: custom path for uploaded images
# QR_UPLOAD_FOLDER=/var/www/qr-uploads
