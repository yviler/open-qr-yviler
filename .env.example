# Base URL of your POS system (no trailing slash)
POS_BASE_URL=http://127.0.0.1:5000

# Secret token the POS requires on incoming QR orders (leave empty if not used)
QR_TOKEN=

# Language shown on the ordering page by default (en or id)
QR_LANG=en

# Default guest name used when no name is provided
QR_GUEST_NAME=Guest

# Port the app listens on
PORT=5001
